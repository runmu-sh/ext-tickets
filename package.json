{
  "name": "@runmu.sh/ext-tickets",
  "version": "1.2.1",
  "description": "The staff ticket queue and the player's own tickets (My tickets), driven by GMCP Client.Tickets.*, by another extension through its API, or (My tickets) by parsing the game's @tickets text.",
  "keywords": [
    "tickets",
    "staff",
    "helpdesk",
    "gmcp",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/tickets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-tickets.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-tickets/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./src/types.ts",
  "files": [
    "dist",
    "src/types.ts",
    "README.md",
    "CHANGELOG.md",
    "src/text.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.6.0",
    "@runmu.sh/dev": "^0.1.0",
    "@runmu.sh/ext-kit": "^1.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "muclient": {
    "id": "tickets",
    "api": "^1.5",
    "source": "src/index.ts",
    "displayName": "Tickets",
    "description": "The staff ticket queue and the player's own tickets (My tickets), driven by GMCP Client.Tickets.*, by another extension through its API, or (My tickets) by parsing the game's @tickets text.",
    "categories": [
      "interface",
      "communication"
    ],
    "contributes": {
      "panels": [
        {
          "id": "tickets",
          "title": "Tickets"
        },
        {
          "id": "mytickets",
          "title": "My tickets"
        }
      ],
      "gmcp": [
        "Client.Tickets 1"
      ]
    },
    "capabilities": [
      "read-output",
      "send-commands"
    ],
    "publisher": "bitmuse"
  }
}
