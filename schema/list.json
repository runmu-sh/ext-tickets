{
  "$comment": "Client.Tickets.Inbox / History / Mine: a whole list (it replaces the one before). Mine says which list with closed.",
  "type": "object",
  "required": [
    "tickets"
  ],
  "properties": {
    "tickets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ticket"
      }
    },
    "closed": {
      "type": "boolean"
    },
    "search": {
      "type": "string"
    }
  },
  "$defs": {
    "ticket": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "short_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "subject": {
          "type": "string"
        },
        "requester_name": {
          "type": "string"
        },
        "account_name": {
          "type": "string"
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        },
        "age_mins": {
          "type": "number"
        },
        "updated": {
          "type": [
            "number",
            "string"
          ]
        },
        "approvable": {
          "type": "boolean"
        },
        "preview": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "bug": {
          "type": "object"
        }
      }
    },
    "message": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "html": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "ts": {
          "type": [
            "number",
            "string"
          ]
        }
      }
    }
  }
}